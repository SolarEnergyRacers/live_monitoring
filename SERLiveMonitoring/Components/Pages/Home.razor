@page "/"
@implements IDisposable
@inject SerialPortMonitorService SerialService
@inject DataManager DataManager
@inject SettingsService SettingsService
@inject EventTimestampService EventTimestampService
@inject IDialogService DialogService

<PageTitle>Live Overview</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Live Overview</MudText>

@{ var warnings = VehicleWarnings.Evaluate(DataManager, _isConnected, SettingsService.Current.WarningThresholds); }

<MudGrid Spacing="2">
    <MudItem xs="12" md="9">
        <MudGrid Spacing="2">
            @foreach (var stat in MainStats)
            {
                <MudItem xs="12" sm="6" md="4">
                    <StatChartTile Title="@stat.Title" Icon="@stat.Icon" AccentColor="@stat.AccentColor"
                                   ChartColor="@stat.ChartColor" Value="@ValueText(stat)" Series="@SparkSeries(stat)" />
                </MudItem>
            }
        </MudGrid>

        <MudGrid Spacing="2" Class="mt-0">
            @foreach (var stat in MpptStats)
            {
                <MudItem xs="6" sm="3">
                    <StatChartTile Title="@stat.Title" Icon="@stat.Icon" AccentColor="@stat.AccentColor"
                                   ChartColor="@stat.ChartColor" Value="@ValueText(stat)" Series="@SparkSeries(stat)" />
                </MudItem>
            }
        </MudGrid>

        <MudGrid Spacing="2" Class="mt-0">
            <MudItem xs="12" sm="6" md="4">
                <StatChartTile Title="Coordinates" Icon="@Icons.Material.Filled.GpsFixed" AccentColor="MudBlazor.Color.Info"
                               ChartColor="#00BCD4" Value="@GpsCoordinatesText" Series="@GpsSpeedSeries">
                    @if (GpsDeviceNames.Count > 0)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Device</MudText>
                            <MudSelect T="string" Value="_selectedGpsDevice" ValueChanged="OnGpsDeviceSelected"
                                       Dense="true" Margin="Margin.Dense" Class="flex-grow-1">
                                <MudSelectItem T="string" Value="@AllGpsDevicesValue">All devices</MudSelectItem>
                                @foreach (var device in GpsDeviceNames)
                                {
                                    <MudSelectItem T="string" Value="@device">@device</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>
                    }
                    @if (LatestGps is not null)
                    {
                        var mapTrack = BuildGoogleMapsTrackExport();
                        <MudStack Spacing="0" Class="mt-2">
                            @* <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@GpsDeviceNameText</MudText> *@
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@GpsTimestampText, @GpsDeviceNameText, All points: @GpsPointCountText </MudText>
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@BuildGoogleMapsSummary(mapTrack)</MudText>
                            @if (mapTrack.ReducedByUrlLimit)
                            {
                                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Warning">
                                    URL length limit applied: reduced from @mapTrack.SourceCount to @mapTrack.ExportedCount points.
                                </MudText>
                            }
                            <MudStack Row="true" Spacing="2">
                                <MudLink Href="@GpsCurrentLocationMapUrl" Target="_blank" Typo="Typo.caption">
                                    View current location on Maps
                                </MudLink>
                                <MudLink Href="@mapTrack.Url" Target="_blank" Typo="Typo.caption">
                                    View track on Maps (@mapTrack.ExportedCount points)
                                </MudLink>
                            </MudStack>
                        </MudStack>
                    }
                </StatChartTile>
            </MudItem>
            <MudItem xs="12" sm="6" md="8">
                <DriverMessagePanel />
            </MudItem>
        </MudGrid>
    </MudItem>

    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3">Serial Connection</MudText>
            <MudStack Spacing="3">
                <MudGrid Spacing="2">
                    @if (_isConnected)
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.body1">@ConnectedEndpoint</MudText>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="6">
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.End">
                                <MudSelect T="string" Label="COM Port" @bind-Value="_selectedPort" Class="flex-grow-1">
                                    @foreach (var port in _availablePorts)
                                    {
                                        <MudSelectItem T="string" Value="@port">@port</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTooltip Text="Refresh COM Port">
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                                   Color="MudBlazor.Color.Default"
                                                   OnClick="RefreshPorts" />
                                </MudTooltip>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6">
                            <MudSelect T="int" Label="Baud Rate" @bind-Value="_baudRate">
                                @foreach (var baud in _baudRates)
                                {
                                    <MudSelectItem T="int" Value="@baud">@baud</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                </MudGrid>

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton Variant="@(_isConnected ? Variant.Outlined : Variant.Filled)"
                               Color="@(_isConnected ? MudBlazor.Color.Error : MudBlazor.Color.Primary)"
                               StartIcon="@(_isConnected ? Icons.Material.Outlined.LinkOff : Icons.Material.Filled.Link)"
                               OnClick="@(_isConnected ? Disconnect : Connect)"
                               Disabled="@(!_isConnected && string.IsNullOrEmpty(_selectedPort))"
                               Style="width: 130px;">
                        @(_isConnected ? "Disconnect" : "Connect")
                    </MudButton>

                    <MudChip T="string" Color="@StatusColor" Variant="Variant.Filled">@SerialService.Status</MudChip>
                </MudStack>

                @if (!string.IsNullOrEmpty(SerialService.LastError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@SerialService.LastError</MudAlert>
                }
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3">Device Activity</MudText>
            <MudGrid Spacing="2">
                @foreach (var (label, tag) in VehicleWarnings.Devices)
                {
                    <MudItem xs="6">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="MudBlazor.Size.Small" Color="@DeviceDotColor(tag)" />
                            <MudText Typo="Typo.body2">@label</MudText>
                        </MudStack>
                    </MudItem>
                }
                <MudItem xs="6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="MudBlazor.Size.Small" Color="@GpsDotColor" />
                        <MudText Typo="Typo.body2">GPS</MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="2">
            @if (warnings.Count > 0)
            {
                <MudStack Spacing="1" Class="mb-4">
                    @foreach (var warning in warnings)
                    {
                        <MudAlert Severity="@ToSeverity(warning.Level)" Dense="true">@warning.Message</MudAlert>
                    }
                </MudStack>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">No active warnings</MudAlert>
            }
        </MudPaper>

        <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="2">
            <MudExpansionPanels>
                <MudExpansionPanel Text="Live Diagnostics" Expanded="false">
                    <MudTable Items="SignalDiagnostics" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Signal</MudTh>
                            <MudTh>Value</MudTh>
                            <MudTh>Age</MudTh>
                            <MudTh>Last Update</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Signal">@context.Label</MudTd>
                            <MudTd DataLabel="Value">@context.ValueText</MudTd>
                            <MudTd DataLabel="Age">
                                <MudChip T="string" Color="@context.AgeColor" Variant="Variant.Filled">@context.AgeText</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Last Update">@context.UpdatedText</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 rounded-lg mt-4" Elevation="2">
    <MudText Typo="Typo.subtitle1" Class="mb-3">Event Timestamps</MudText>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudStack Spacing="3">
                <MudTextField T="string" Label="Event Name" @bind-Value="_eventName" Variant="Variant.Outlined" />

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle"
                               OnClick="AddNow" Disabled="string.IsNullOrWhiteSpace(_eventName)" FullWidth="true">
                        Now
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Schedule"
                               OnClick="AddCustom" Disabled="string.IsNullOrWhiteSpace(_eventName)" FullWidth="true">
                        Custom Time…
                    </MudButton>
                </MudStack>

                <MudTable Items="Events" Dense="true" Hover="true" Height="280px" FixedHeader="true">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Time</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Time">@context.Timestamp.ToString("g")</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="MudBlazor.Size.Small"
                                           Color="MudBlazor.Color.Error" OnClick="() => DeleteEvent(context.Id)" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">No events recorded yet</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="8">
            <div style="height: 380px">
                @if (SpeedHistory.Count >= 2)
                {
                    <ApexChart TItem="TimeSeriesPoint" @ref="_speedChart" Height="380" Options="_speedChartOptions">
                        <ApexPointSeries TItem="TimeSeriesPoint"
                                         Items="SpeedHistory"
                                         Name="Speed"
                                         SeriesType="SeriesType.Line"
                                         XValue="p => ToEpochMs(p.Timestamp)"
                                         YValue="p => (decimal)p.Value"
                                         ShowDataLabels="false" />
                    </ApexChart>
                }
                else
                {
                    <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Style="height: 100%">
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Waiting for data…</MudText>
                    </MudStack>
                }
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private static readonly TimeSpan AvgWindow = TimeSpan.FromSeconds(15);
    private static readonly TimeSpan SparkWindow = TimeSpan.FromSeconds(60);
    private static readonly TimeSpan DataFlowingThreshold = TimeSpan.FromSeconds(2);
    private static readonly int[] _baudRates = [9600, 19200, 38400, 57600, 115200];

    private static readonly StatDef[] MainStats =
    [
        new("Speed", Icons.Material.Filled.Speed, MudBlazor.Color.Info, "#42A5F5", ChartSeries.Speed, " km/h"),
        new("Solar Power", Icons.Material.Filled.WbSunny, MudBlazor.Color.Warning, "#FFC107", ChartSeries.SolarTotal, " W"),
        new("Motor Power", Icons.Material.Filled.ElectricBolt, MudBlazor.Color.Tertiary, "#FF7043", ChartSeries.MotorPower, " W"),
        new("Battery Power", Icons.Material.Filled.Power, MudBlazor.Color.Success, "#26A69A", ChartSeries.BatteryPower, " W"),
        new("Battery Voltage", Icons.Material.Filled.Bolt, MudBlazor.Color.Primary, "#7E57C2", ChartSeries.BatteryVoltage, " V"),
        new("Battery Current", Icons.Material.Filled.Bolt, MudBlazor.Color.Primary, "#7E57C2", ChartSeries.BatteryCurrent, " A"),
    ];

    private static readonly StatDef[] MpptStats =
    [
        new("MPPT 1", Icons.Material.Filled.SolarPower, MudBlazor.Color.Warning, "#FFC107", ChartSeries.Mppt1, " W"),
        new("MPPT 2", Icons.Material.Filled.SolarPower, MudBlazor.Color.Warning, "#FFB300", ChartSeries.Mppt2, " W"),
        new("MPPT 3", Icons.Material.Filled.SolarPower, MudBlazor.Color.Warning, "#FFA000", ChartSeries.Mppt3, " W"),
        new("MPPT 4", Icons.Material.Filled.SolarPower, MudBlazor.Color.Warning, "#FF8F00", ChartSeries.Mppt4, " W"),
    ];

    private List<string> _availablePorts = [];
    private System.Threading.Timer? _uiRefreshTimer;

    private string? _selectedPort;
    private int _baudRate = 115200;
    private bool _isConnected => SerialService.Status == SerialConnectionStatus.Connected;

    private bool _blinkPhase;

    private bool DeviceFlowing(string tag)
    {
        var heartbeat = DataManager.GetLatest("device_heartbeat", ("device", tag));
        return heartbeat is not null && DateTime.Now - heartbeat.Timestamp < DataFlowingThreshold;
    }

    private MudBlazor.Color DeviceDotColor(string tag) => DeviceFlowing(tag) && _blinkPhase ? MudBlazor.Color.Success : MudBlazor.Color.Default;

    private MudBlazor.Color StatusColor => SerialService.Status switch
    {
        SerialConnectionStatus.Connected => MudBlazor.Color.Success,
        SerialConnectionStatus.Error => MudBlazor.Color.Error,
        _ => MudBlazor.Color.Default
    };

    private string ConnectedEndpoint => $"{SerialService.PortName ?? _selectedPort ?? "Unknown"}@{_baudRate}";

    private static Severity ToSeverity(WarningLevel level) => level switch
    {
        WarningLevel.Error => Severity.Error,
        _ => Severity.Warning
    };

    private record StatDef(string Title, string Icon, MudBlazor.Color AccentColor, string ChartColor, ChartSeries Series, string Unit);

    private string ValueText(StatDef stat)
    {
        var avg = DataManager.GetAverage(stat.Series, AvgWindow);
        return avg is null ? "--" : avg.Value.ToString("0.#") + stat.Unit;
    }

    private List<double> SparkSeries(StatDef stat) => DataManager.GetSeries(stat.Series, SparkWindow);

    private static readonly TimeSpan SpeedChartWindow = TimeSpan.FromHours(2);
    private static readonly TimeSpan DiagWarnAge = TimeSpan.FromSeconds(3);
    private static readonly TimeSpan DiagErrorAge = TimeSpan.FromSeconds(10);
    private static readonly DiagSignal[] DiagSignals =
    [
        new("speed", "Speed", "km/h"),
        new("targetspeed", "Target Speed", "km/h"),
        new("dc_lifesign", "DC Lifesign", ""),
        new("mc_erpm", "MC ERPM", "erpm"),
        new("batt_volt", "Battery Voltage", "V"),
        new("batt_curr", "Battery Current", "A"),
        new("calc_batt_power", "Battery Power", "W"),
        new("calc_mppt_out_power", "MPPT Output Power", "W")
    ];

    private string _eventName = "";
    private ApexChart<TimeSeriesPoint>? _speedChart;
    private ApexChartOptions<TimeSeriesPoint> _speedChartOptions = new();
    private bool _updatingChart;
    private bool _disposed;

    private record DiagSignal(string ReadingName, string Label, string Unit);
    private record DiagRow(string Label, string ValueText, string AgeText, string UpdatedText, MudBlazor.Color AgeColor);

    private List<EventTimestamp> Events => EventTimestampService.GetAll();
    private List<TimeSeriesPoint> SpeedHistory => DataManager.GetSpeedHistory(SpeedChartWindow);
    private List<DiagRow> SignalDiagnostics => DiagSignals.Select(BuildDiagRow).Append(BuildGpsDiagRow()).ToList();

    private const int GpsSparkPointCount = 1000;
    private static readonly TimeSpan GpsFlowingThreshold = TimeSpan.FromSeconds(30);
    private const string AllGpsDevicesValue = "";
    private string _selectedGpsDevice = AllGpsDevicesValue;

    private List<string> GpsDeviceNames => DataManager.GetGpsDeviceNames();

    private void OnGpsDeviceSelected(string device) => _selectedGpsDevice = device;

    private GpsPoint? LatestGps => string.IsNullOrEmpty(_selectedGpsDevice)
        ? DataManager.GetLatestGpsPoint()
        : DataManager.GetLatestGpsPoint(_selectedGpsDevice);

    private List<GpsPoint> LastGpsSparkPoints => string.IsNullOrEmpty(_selectedGpsDevice)
        ? DataManager.GetLastGpsPoints(GpsSparkPointCount)
        : DataManager.GetLastGpsPoints(GpsSparkPointCount, _selectedGpsDevice);

    private string GpsSpeedText => LatestGps is { SpeedKmh: { } spd } ? spd.ToString("0.#") + " km/h" : "--";

    private string GpsCoordinatesText => LatestGps is { } gps
        ? $"{gps.Latitude.ToString("0.0000")}, {gps.Longitude.ToString("0.0000")} · {GpsSpeedText}"
        : "--";

    private string GpsDeviceNameText => LatestGps is { } gps ? gps.DeviceName : "";

    // Single-point view of whatever LatestGps currently resolves to (respects the device filter),
    // as opposed to BuildGoogleMapsTrackExport's multi-point track.
    private string GpsCurrentLocationMapUrl => LatestGps is { } gps
        ? $"https://www.google.com/maps/search/?api=1&query={gps.Latitude.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture)},{gps.Longitude.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture)}"
        : "https://www.google.com/maps";

    private string GpsPointCountText => (string.IsNullOrEmpty(_selectedGpsDevice)
        ? DataManager.GetGpsPointCount()
        : DataManager.GetGpsPointCount(_selectedGpsDevice)).ToString();

    private string GpsTimestampText => LatestGps is { } gps
        ? gps.Timestamp.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") + " UTC"
        : "No GPS data yet";

    private List<double> GpsSpeedSeries => LastGpsSparkPoints.Select(p => p.SpeedKmh ?? 0).ToList();

    private bool GpsFlowing => LatestGps is { } gps && DateTime.Now - gps.Timestamp < GpsFlowingThreshold;
    private MudBlazor.Color GpsDotColor => GpsFlowing && _blinkPhase ? MudBlazor.Color.Success : MudBlazor.Color.Default;

    private int ConfiguredGoogleMapsSourcePointCount =>
        Math.Clamp(
            SettingsService.Current.GoogleMapsSourcePointCount,
            AppSettings.MinGoogleMapsSourcePointCount,
            AppSettings.MaxGoogleMapsSourcePointCount);

    private GoogleMapsTrackExport BuildGoogleMapsTrackExport()
    {
        var points = string.IsNullOrEmpty(_selectedGpsDevice)
            ? DataManager.GetLastGpsPoints(ConfiguredGoogleMapsSourcePointCount)
            : DataManager.GetLastGpsPoints(ConfiguredGoogleMapsSourcePointCount, _selectedGpsDevice);
        return GoogleMapsTrackBuilder.Build(points);
    }

    private string BuildGoogleMapsSummary(GoogleMapsTrackExport track)
    {
        if (track.SourceCount == 0)
            return "No GPS points available yet.";

        if (track.SourceCount == 1)
            return $"Source points: 1 (setting: {ConfiguredGoogleMapsSourcePointCount}).";

        return $"Source points: {track.SourceCount} (setting: {ConfiguredGoogleMapsSourcePointCount}). Sampling gap: every {track.GapPoints} point(s) (~{track.GapSeconds}s).";
    }



    private DiagRow BuildGpsDiagRow()
    {
        var latest = DataManager.GetLatestGpsPoint();
        if (latest is null)
            return new DiagRow("GPS API Calls", "0 total", "no data", "--", MudBlazor.Color.Error);

        var age = DateTime.Now - latest.Timestamp;
        var ageColor = age >= DiagErrorAge
            ? MudBlazor.Color.Error
            : age >= DiagWarnAge
                ? MudBlazor.Color.Warning
                : MudBlazor.Color.Success;

        return new DiagRow(
            "GPS API Calls",
            $"{DataManager.GetGpsPointCount()} total",
            age.TotalSeconds < 1 ? "<1s" : $"{Math.Floor(age.TotalSeconds)}s",
            latest.Timestamp.ToString("HH:mm:ss"),
            ageColor);
    }

    private DiagRow BuildDiagRow(DiagSignal signal)
    {
        var latest = DataManager.GetLatestSingle(signal.ReadingName);
        if (latest is null)
            return new DiagRow(signal.Label, "--", "no data", "--", MudBlazor.Color.Error);

        var age = DateTime.Now - latest.Timestamp;
        var value = latest.Value.ToString("0.###");
        if (!string.IsNullOrWhiteSpace(signal.Unit))
            value += " " + signal.Unit;

        var ageColor = age >= DiagErrorAge
            ? MudBlazor.Color.Error
            : age >= DiagWarnAge
                ? MudBlazor.Color.Warning
                : MudBlazor.Color.Success;

        return new DiagRow(
            signal.Label,
            value,
            age.TotalSeconds < 1 ? "<1s" : $"{Math.Floor(age.TotalSeconds)}s",
            latest.Timestamp.ToString("HH:mm:ss"),
            ageColor);
    }

    private static long ToEpochMs(DateTime dt) => new DateTimeOffset(dt).ToUnixTimeMilliseconds();

    private void BuildSpeedChartOptions()
    {
        var windowStart = DateTime.Now - SpeedChartWindow;

        _speedChartOptions = new ApexChartOptions<TimeSeriesPoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Animations = new Animations { Enabled = false }
            },
            Stroke = new Stroke { Width = 2, Curve = Curve.Smooth },
            Colors = new List<string> { "#42A5F5" },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                AxisTicks = new AxisTicks { Show = true, Color = "#FFFFFF" },
                Labels = new XAxisLabels { Style = new AxisLabelStyle { Colors = "#FFFFFF" }, DatetimeUTC = false }
            },
            Yaxis = new List<YAxis>
            {
                new()
                {
                    Title = new AxisTitle { Text = "km/h", Style = new AxisTitleStyle { Color = "#FFFFFF" } },
                    DecimalsInFloat = 0,
                    AxisBorder = new AxisBorder { Show = true, Color = "#FFFFFF" },
                    AxisTicks = new AxisTicks { Show = true, Color = "#FFFFFF" },
                    Labels = new YAxisLabels { Style = new AxisLabelStyle { Colors = "#FFFFFF" } }
                }
            },
            Annotations = new Annotations
            {
                Xaxis = Events
                    .Where(e => e.Timestamp >= windowStart)
                    .Select(e => new AnnotationsXAxis
                    {
                        X = ToEpochMs(e.Timestamp),
                        BorderColor = "#FFC107",
                        Label = new Label
                        {
                            Text = e.Name,
                            Style = new Style { Color = "#000000", Background = "#FFC107" }
                        }
                    })
                    .ToList()
            }
        };
    }

    private void AddNow()
    {
        if (string.IsNullOrWhiteSpace(_eventName))
            return;

        EventTimestampService.Add(_eventName.Trim(), DateTime.Now);
        _eventName = "";
    }

    private async Task AddCustom()
    {
        if (string.IsNullOrWhiteSpace(_eventName))
            return;

        var dialogRef = await DialogService.ShowAsync(typeof(CustomTimeDialog), "Choose Time");
        var result = await dialogRef.Result;

        if (result is { Canceled: false, Data: DateTime chosen })
        {
            EventTimestampService.Add(_eventName.Trim(), chosen);
            _eventName = "";
        }
    }

    private void DeleteEvent(long id) => EventTimestampService.Delete(id);

    protected override void OnInitialized()
    {
        RefreshPorts();
        SerialService.StatusChanged += OnStatusChanged;
        BuildSpeedChartOptions();

        // redraw ui at 2Hz, to prevent redrawing for every CAN frame received
        _uiRefreshTimer = new System.Threading.Timer(
            _ =>
            {
                if (_disposed)
                    return;

                _blinkPhase = !_blinkPhase;
                BuildSpeedChartOptions();
                InvokeAsync(StateHasChanged);
            },
            null,
            TimeSpan.FromMilliseconds(500),
            TimeSpan.FromMilliseconds(500));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // _updatingChart guards against the 500ms timer re-entering before the previous JS interop
        // round-trip finishes. Both awaits can throw TaskCanceledException (or JSDisconnectedException)
        // if the user navigates away - or the circuit disconnects - mid-call, which is benign: the
        // chart is being torn down anyway, so there's nothing to recover.
        if (firstRender || _speedChart is null || _updatingChart || _disposed)
            return;

        _updatingChart = true;
        try
        {
            await _speedChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
            await _speedChart.UpdateSeriesAsync();
        }
        catch (Exception ex) when (ex is TaskCanceledException or JSDisconnectedException)
        {
        }
        finally
        {
            _updatingChart = false;
        }
    }

    private void RefreshPorts()
    {
        _availablePorts = [.. SerialPortMonitorService.GetAvailablePortNames()];
        if (_selectedPort is null || !_availablePorts.Contains(_selectedPort))
            _selectedPort = _availablePorts.FirstOrDefault();
    }

    private void Connect()
    {
        if (!string.IsNullOrEmpty(_selectedPort))
            SerialService.Connect(_selectedPort, _baudRate);
    }

    private void Disconnect() => SerialService.Disconnect();

    private void OnStatusChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        _uiRefreshTimer?.Dispose();
        SerialService.StatusChanged -= OnStatusChanged;
    }
}
