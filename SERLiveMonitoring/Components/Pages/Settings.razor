@page "/settings"
@using System.Globalization
@using SERLiveMonitoring
@using SERLiveMonitoring.Components
@using SERLiveMonitoring.Components.Layout
@using SERLiveMonitoring.Components.Shared
@using SERLiveMonitoring.Models
@using SERLiveMonitoring.Services
@inject SettingsService SettingsService
@inject ISnackbar Snackbar

<PageTitle>Settings</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Settings</MudText>

<MudGrid>
    <MudItem xs="12" md="6" lg="4">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-1">CAN Bus Addresses</MudText>
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="mb-3">
                Standard 11-bit CAN base address per device, in hex (0x000-0x7FF).
            </MudText>
            <MudStack Spacing="3">
                @foreach (var field in _addressFields)
                {
                    <MudTextField T="string" Label="@field.Label" @bind-Value="field.HexValue"
                                  Error="@(field.ErrorText is not null)" ErrorText="@field.ErrorText"
                                  Variant="Variant.Outlined" />
                }
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6" lg="4">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3">Warning Thresholds</MudText>
            <MudStack Spacing="3">
                <MudNumericField T="double" Label="Max cell voltage spread" @bind-Value="_thresholds.MaxCellVoltageSpreadV" Min="0" Step="0.01" Adornment="Adornment.End" AdornmentText="V" Variant="Variant.Outlined" />
                <MudNumericField T="double" Label="Max battery cell temperature" @bind-Value="_thresholds.MaxCellTempC" Min="0" Step="1" Adornment="Adornment.End" AdornmentText="°C" Variant="Variant.Outlined" />
                <MudNumericField T="double" Label="Max motor/FET temperature" @bind-Value="_thresholds.MaxMotorTempC" Min="0" Step="1" Adornment="Adornment.End" AdornmentText="°C" Variant="Variant.Outlined" />
                <MudNumericField T="double" Label="Max MPPT MOSFET temperature" @bind-Value="_thresholds.MaxMpptTempC" Min="0" Step="1" Adornment="Adornment.End" AdornmentText="°C" Variant="Variant.Outlined" />
                <MudNumericField T="double" Label="Min active MPPT power" @bind-Value="_thresholds.MinActiveMpptPowerW" Min="0" Step="1" Adornment="Adornment.End" AdornmentText="W" Variant="Variant.Outlined"
                                 HelperText="Below this, a panel is treated as idle rather than underperforming" />
                <MudNumericField T="double" Label="Low MPPT power ratio" @bind-Value="_thresholds.LowMpptPowerRatio" Min="0" Max="1" Step="0.05" Variant="Variant.Outlined"
                                 HelperText="Flag a panel once it makes less than this fraction of the other active panels' average" />
                <MudNumericField T="double" Label="Device communication timeout" @bind-Value="_thresholds.CommTimeoutSeconds" Min="1" Step="1" Adornment="Adornment.End" AdornmentText="s" Variant="Variant.Outlined" />
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6" lg="4">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3">General</MudText>
            <MudStack Spacing="3">
                <MudNumericField T="int"
                                 Label="Tile average window"
                                 @bind-Value="_tileAverageSeconds"
                                 Min="@AppSettings.MinTileAverageSeconds"
                                 Max="@AppSettings.MaxTileAverageSeconds"
                                 Step="1"
                                 Adornment="Adornment.End"
                                 AdornmentText="s"
                                 Variant="Variant.Outlined"
                                 HelperText="Seconds of recent data used for the live dashboard tile values." />
                <MudNumericField T="int"
                                 Label="Google Maps source points"
                                 @bind-Value="_googleMapsSourcePointCount"
                                 Min="@AppSettings.MinGoogleMapsSourcePointCount"
                                 Max="@AppSettings.MaxGoogleMapsSourcePointCount"
                                 Step="1"
                                 Variant="Variant.Outlined"
                                 HelperText="Number of latest GPS points considered before automatic URL-safe downsampling." />
                <MudDivider />
                <MudCheckBox T="bool" @bind-Value="_noMcCanData" Label="No MC CAN Data"
                             Color="MudBlazor.Color.Primary" />
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="mt-n2">
                    Enable if the motor controller doesn't send current/power over CAN. Motor current
                    and power are then derived from battery current plus total MPPT output current.
                </MudText>
                <MudDivider />
                <MudSelect T="string" Label="Color theme" @bind-Value="_theme" Variant="Variant.Outlined">
                    @foreach (var name in ThemeCatalog.Names)
                    {
                        <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3">Chart Scale Limits</MudText>
            <MudStack Spacing="2">
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2" Style="width:120px; flex-shrink:0;">Speed</MudText>
                    <MudNumericField T="double" Label="Min" @bind-Value="_chartRanges.Speed.Min" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Max" @bind-Value="_chartRanges.Speed.Max" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt min" @bind-Value="_chartRanges.Speed.OptimalMin" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt max" @bind-Value="_chartRanges.Speed.OptimalMax" Variant="Variant.Outlined" Style="width:90px;" />
                </MudStack>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2" Style="width:120px; flex-shrink:0;">Solar Power</MudText>
                    <MudNumericField T="double" Label="Min" @bind-Value="_chartRanges.SolarPower.Min" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Max" @bind-Value="_chartRanges.SolarPower.Max" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt min" @bind-Value="_chartRanges.SolarPower.OptimalMin" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt max" @bind-Value="_chartRanges.SolarPower.OptimalMax" Variant="Variant.Outlined" Style="width:90px;" />
                </MudStack>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2" Style="width:120px; flex-shrink:0;">Motor Power</MudText>
                    <MudNumericField T="double" Label="Min" @bind-Value="_chartRanges.MotorPower.Min" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Max" @bind-Value="_chartRanges.MotorPower.Max" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt min" @bind-Value="_chartRanges.MotorPower.OptimalMin" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt max" @bind-Value="_chartRanges.MotorPower.OptimalMax" Variant="Variant.Outlined" Style="width:90px;" />
                </MudStack>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2" Style="width:120px; flex-shrink:0;">Battery Power</MudText>
                    <MudNumericField T="double" Label="Min" @bind-Value="_chartRanges.BatteryPower.Min" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Max" @bind-Value="_chartRanges.BatteryPower.Max" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt min" @bind-Value="_chartRanges.BatteryPower.OptimalMin" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt max" @bind-Value="_chartRanges.BatteryPower.OptimalMax" Variant="Variant.Outlined" Style="width:90px;" />
                </MudStack>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2" Style="width:120px; flex-shrink:0;">Battery Voltage</MudText>
                    <MudNumericField T="double" Label="Min" @bind-Value="_chartRanges.BatteryVoltage.Min" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Max" @bind-Value="_chartRanges.BatteryVoltage.Max" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt min" @bind-Value="_chartRanges.BatteryVoltage.OptimalMin" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt max" @bind-Value="_chartRanges.BatteryVoltage.OptimalMax" Variant="Variant.Outlined" Style="width:90px;" />
                </MudStack>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2" Style="width:120px; flex-shrink:0;">Battery Current</MudText>
                    <MudNumericField T="double" Label="Min" @bind-Value="_chartRanges.BatteryCurrent.Min" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Max" @bind-Value="_chartRanges.BatteryCurrent.Max" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt min" @bind-Value="_chartRanges.BatteryCurrent.OptimalMin" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt max" @bind-Value="_chartRanges.BatteryCurrent.OptimalMax" Variant="Variant.Outlined" Style="width:90px;" />
                </MudStack>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2" Style="width:120px; flex-shrink:0;">MPPT</MudText>
                    <MudNumericField T="double" Label="Min" @bind-Value="_chartRanges.Mppt.Min" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Max" @bind-Value="_chartRanges.Mppt.Max" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt min" @bind-Value="_chartRanges.Mppt.OptimalMin" Variant="Variant.Outlined" Style="width:90px;" />
                    <MudNumericField T="double" Label="Opt max" @bind-Value="_chartRanges.Mppt.OptimalMax" Variant="Variant.Outlined" Style="width:90px;" />
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>

</MudGrid>

<MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetToDefaults">Reset to Defaults</MudButton>
    <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">Save</MudButton>
</MudStack>

@code {
    private class AddressField
    {
        public required string Label { get; init; }
        public required Func<CanAddressSettings, short> Get { get; init; }
        public required Action<CanAddressSettings, short> Set { get; init; }
        public string HexValue { get; set; } = "";
        public string? ErrorText { get; set; }
    }

    private static readonly List<AddressField> FieldDefs =
    [
        new() { Label = "MPPT 1", Get = c => c.Mppt1Addr, Set = (c, v) => c.Mppt1Addr = v },
        new() { Label = "MPPT 2", Get = c => c.Mppt2Addr, Set = (c, v) => c.Mppt2Addr = v },
        new() { Label = "MPPT 3", Get = c => c.Mppt3Addr, Set = (c, v) => c.Mppt3Addr = v },
        new() { Label = "MPPT 4", Get = c => c.Mppt4Addr, Set = (c, v) => c.Mppt4Addr = v },
        new() { Label = "BMS", Get = c => c.BmsBaseAddr, Set = (c, v) => c.BmsBaseAddr = v },
        new() { Label = "AC", Get = c => c.AcBaseAddr, Set = (c, v) => c.AcBaseAddr = v },
        new() { Label = "DC", Get = c => c.DcBaseAddr, Set = (c, v) => c.DcBaseAddr = v },
        new() { Label = "MC", Get = c => c.McBaseAddr, Set = (c, v) => c.McBaseAddr = v },
    ];

    private List<AddressField> _addressFields = [];
    private WarningThresholds _thresholds = new();
    private ChartRangeSettings _chartRanges = new();
    private int _tileAverageSeconds = AppSettings.DefaultTileAverageSeconds;
    private int _googleMapsSourcePointCount = AppSettings.DefaultGoogleMapsSourcePointCount;
    private bool _noMcCanData;
    private string _theme = ThemeCatalog.Dark;
    protected override void OnInitialized() => LoadFromSettings(SettingsService.Current);

    private void LoadFromSettings(AppSettings settings)
    {
        // Clone rather than bind directly to the live settings objects - CANFrameDecoder and
        // VehicleWarnings read those concurrently, so mutating them keystroke-by-keystroke before
        // Save is clicked would be both a UX surprise and a thread-safety bug.
        _thresholds = new WarningThresholds
        {
            MaxCellVoltageSpreadV = settings.WarningThresholds.MaxCellVoltageSpreadV,
            MaxCellTempC = settings.WarningThresholds.MaxCellTempC,
            MaxMotorTempC = settings.WarningThresholds.MaxMotorTempC,
            MaxMpptTempC = settings.WarningThresholds.MaxMpptTempC,
            MinActiveMpptPowerW = settings.WarningThresholds.MinActiveMpptPowerW,
            LowMpptPowerRatio = settings.WarningThresholds.LowMpptPowerRatio,
            CommTimeoutSeconds = settings.WarningThresholds.CommTimeoutSeconds
        };

        _chartRanges = new ChartRangeSettings
        {
            Speed = CloneRange(settings.ChartRanges.Speed),
            SolarPower = CloneRange(settings.ChartRanges.SolarPower),
            MotorPower = CloneRange(settings.ChartRanges.MotorPower),
            BatteryPower = CloneRange(settings.ChartRanges.BatteryPower),
            BatteryVoltage = CloneRange(settings.ChartRanges.BatteryVoltage),
            BatteryCurrent = CloneRange(settings.ChartRanges.BatteryCurrent),
            Mppt = CloneRange(settings.ChartRanges.Mppt)
        };

        _tileAverageSeconds = Math.Clamp(
            settings.TileAverageSeconds,
            AppSettings.MinTileAverageSeconds,
            AppSettings.MaxTileAverageSeconds);

        _googleMapsSourcePointCount = Math.Clamp(
            settings.GoogleMapsSourcePointCount,
            AppSettings.MinGoogleMapsSourcePointCount,
            AppSettings.MaxGoogleMapsSourcePointCount);

        _noMcCanData = settings.NoMcCanData;
        _theme = ThemeCatalog.Names.Contains(settings.Theme) ? settings.Theme : ThemeCatalog.Dark;

        _addressFields = FieldDefs.Select(f => new AddressField
        {
            Label = f.Label,
            Get = f.Get,
            Set = f.Set,
            HexValue = "0x" + f.Get(settings.CanAddresses).ToString("X3")
        }).ToList();
    }

    private static ChartRangeDefinition CloneRange(ChartRangeDefinition range) => new()
    {
        Min = range.Min,
        Max = range.Max,
        OptimalMin = range.OptimalMin,
        OptimalMax = range.OptimalMax
    };

    private void Save()
    {
        var addresses = new CanAddressSettings();
        var hasError = false;

        foreach (var field in _addressFields)
        {
            field.ErrorText = ParseHexAddress(field.HexValue, out var value);
            if (field.ErrorText is not null)
            {
                hasError = true;
                continue;
            }

            field.Set(addresses, value);
        }

        if (hasError)
        {
            Snackbar.Add("Fix the highlighted CAN addresses before saving", Severity.Error);
            return;
        }

        if (_googleMapsSourcePointCount is < AppSettings.MinGoogleMapsSourcePointCount or > AppSettings.MaxGoogleMapsSourcePointCount)
        {
            Snackbar.Add($"Google Maps source points must be between {AppSettings.MinGoogleMapsSourcePointCount} and {AppSettings.MaxGoogleMapsSourcePointCount}", Severity.Error);
            return;
        }

        if (_tileAverageSeconds is < AppSettings.MinTileAverageSeconds or > AppSettings.MaxTileAverageSeconds)
        {
            Snackbar.Add($"Tile average window must be between {AppSettings.MinTileAverageSeconds} and {AppSettings.MaxTileAverageSeconds} seconds", Severity.Error);
            return;
        }

        foreach (var range in new[]
        {
            _chartRanges.Speed,
            _chartRanges.SolarPower,
            _chartRanges.MotorPower,
            _chartRanges.BatteryPower,
            _chartRanges.BatteryVoltage,
            _chartRanges.BatteryCurrent,
            _chartRanges.Mppt
        })
        {
            if (range.Min > range.Max)
            {
                Snackbar.Add("Each chart range minimum must be less than or equal to its maximum.", Severity.Error);
                return;
            }

            if (range.OptimalMin > range.OptimalMax)
            {
                Snackbar.Add("Each chart optimal range minimum must be less than or equal to its maximum.", Severity.Error);
                return;
            }
        }

        SettingsService.Update(new AppSettings
        {
            CanAddresses = addresses,
            WarningThresholds = _thresholds,
            ChartRanges = _chartRanges,
            TileAverageSeconds = _tileAverageSeconds,
            GoogleMapsSourcePointCount = _googleMapsSourcePointCount,
            NoMcCanData = _noMcCanData,
            Theme = _theme
        });
        Snackbar.Add("Settings saved", Severity.Success);
    }

    private static string? ParseHexAddress(string text, out short value)
    {
        var trimmed = text.Trim();
        if (trimmed.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
            trimmed = trimmed[2..];

        if (!short.TryParse(trimmed, NumberStyles.HexNumber, CultureInfo.InvariantCulture, out value) || value is < 0 or > 0x7FF)
        {
            value = 0;
            return "Enter a hex address between 0x000 and 0x7FF";
        }

        return null;
    }

    private void ResetToDefaults() => LoadFromSettings(new AppSettings());
}
